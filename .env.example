# --- Base de données (Neon en production) ---
# URL poolée (host contenant "-pooler") utilisée par l'application
DATABASE_URL="postgresql://user:pass@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# URL directe (sans "-pooler") utilisée uniquement pour les migrations Prisma
DIRECT_URL="postgresql://user:pass@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- Authentification ---
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
CRON_SECRET="generate-a-random-string"

# --- Comptes de démarrage (seed). Mots de passe générés si absents. ---
SEED_ADMIN_EMAIL="admin@garage.local"
SEED_SECRETARIAT_EMAIL="secretariat@garage.local"
SEED_MECANICIEN_EMAIL="mecanicien@garage.local"
SEED_ADMIN_PASSWORD=""
SEED_SECRETARIAT_PASSWORD=""
SEED_MECANICIEN_PASSWORD=""

# --- Stockage fichiers S3 compatible (signatures, photos) ---
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# --- Intégrations ---
VIN_DECODER_API_URL=""
VIN_DECODER_API_KEY=""
# Décodage de plaque : aucun fournisseur branché pour l'instant (saisie manuelle tant que ces deux lignes sont vides)
PLAQUE_DECODER_API_URL=""
PLAQUE_DECODER_API_KEY=""
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
SMS_PARTNER_API_KEY=""
SMS_PARTNER_SENDER="GARAGE"
FACTURE_ELECTRONIQUE_PROVIDER="mock"
FACTURE_ELECTRONIQUE_API_KEY=""

# Nombre de proxys de confiance devant l'application (limitation des connexions par IP).
# 1 = Vercel ou un reverse proxy (nginx, Caddy…) ; 0 = application exposée directement.
TRUSTED_PROXY_HOPS="1"

# Nom de l'application affiché dans l'interface (barre latérale, connexion, onglet, PWA, PDF).
NEXT_PUBLIC_APP_NAME="MecaCore"
